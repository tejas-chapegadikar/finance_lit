generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// The six Financial Readiness areas on the dashboard. Each lesson feeds
// exactly one of them.
enum ReadinessArea {
  BUDGETING
  DIGITAL_SAFETY
  BANKING
  CREDIT
  TAX
  INVESTING
}

// Asked during onboarding.
enum LearnerStage {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FINAL_YEAR
  GRADUATE_WORKING
}

// Asked (optionally) during onboarding; editable on the profile page.
enum LearningGoal {
  MANAGING_MONEY
  CREDIT
  INVESTING
  AVOIDING_SCAMS
  SALARY_TAXES
  // No longer offered; old answers were converted to all five topics.
  EVERYTHING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum XPTransactionType {
  SIGNUP_BONUS
  QUIZ_COMPLETION
  // Answering the single Question of the Day.
  QUESTION_OF_THE_DAY
  LEVEL_COMPLETION
  // A streak milestone (3, 7, 14, 30, 100 days).
  STREAK_BONUS
  ADMIN_ADJUSTMENT
  // XP spent in the Rewards Store, a negative amount.
  REDEMPTION
  SCENARIO_COMPLETION
  REVISION
  // Finishing the multi-step Daily Challenge.
  DAILY_CHALLENGE
  // Completing all three of the day's missions.
  MISSION_BONUS
  // The day's money check-in (logging spending, or marking a no-spend day).
  MONEY_CHECKIN
  // A step or the finish of a practice challenge (30-day habit, saving challenges).
  PRACTICE_CHALLENGE
  // Taking the Money Personality Quiz (once).
  PERSONALITY_QUIZ
  // Reaching a savings goal (limits in src/actions/money.ts).
  SAVINGS_GOAL
}

enum MoneyEntryKind {
  INCOME
  EXPENSE
}

// How a day's money check-in happened: by logging something, or by saying nothing was spent.
enum MoneyCheckInKind {
  LOGGED
  NO_SPEND
}

// MISTAKE: a question the student missed, brought back at 1, 3 and 7 days.
// CHECK: a 7-day retention check on a lesson they got right.
enum RevisionKind {
  MISTAKE
  CHECK
}

enum RevisionStatus {
  ACTIVE
  DONE
}

// COACH_CHECK: the AI Coach's "check you've got it" question during a quiz.
// REVIEW: a scheduled revision question.
enum RevisionContext {
  COACH_CHECK
  REVIEW
}

model User {
  id            String  @id @default(cuid())
  // The Supabase Auth user id (auth.users.id). Login lives in Supabase;
  // everything else lives here, linked by this id.
  authId        String? @unique
  // From the earlier Clerk login, kept so old accounts can be relinked.
  clerkId       String? @unique
  email         String  @unique
  emailVerified Boolean @default(false)
  phone         String? @unique
  phoneVerified Boolean @default(false)
  name          String?
  displayName   String?

  stage                 LearnerStage?
  // Old single choice: no longer written or read. Kept so older deployments keep working.
  goal                  LearningGoal?
  // What they want to get better at (any number of topics).
  goals                 LearningGoal[] @default([])
  collegeName           String?
  onboardingCompletedAt DateTime?

  // Lifetime XP earned, never goes down. Spendable XP is xpTotal - xpSpent.
  xpTotal Int     @default(0)
  xpSpent Int     @default(0)
  // Equipped Rewards Store unlocks (reward ids from src/lib/rewards.ts).
  title   String?
  theme   String?
  // The student's avatar: { slot: itemId } (items in src/lib/avatar.ts); null = default look.
  avatar  Json?

  // Optional daily reminder email at this IST hour (0-23).
  reminderEnabled     Boolean @default(false)
  reminderHour        Int     @default(20)
  reminderLastSentDay String?

  // Days in a row with a meaningful learning action (a quiz, scenario,
  // revision answer, Question of the Day or Daily Challenge), in IST days.
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  // IST date (YYYY-MM-DD) of the last day that counted toward the streak.
  streakLastDay    String?
  // Last time the student opened a lesson or started a quiz, feeds retention metrics.
  lastActivityDate DateTime?
  // Streak freezes held (max 2): each covers one missed day automatically.
  // Earned every 7 days of streak, never bought.
  streakFreezes    Int       @default(1)

  // The Money Personality Quiz result (ids in src/lib/personality.ts), a
  // playful starting point that personalises suggestions; retakeable anytime.
  moneyPersonality String?
  personalityAt    DateTime?
  // Opted in to the friendly weekly XP league (off by default: names are only
  // shown to other students when this is on).
  leagueOptIn      Boolean   @default(false)
  // Whether the avatar pops up to react to what you do (Settings).
  avatarReactions  Boolean   @default(true)

  quizAttempts         QuizAttempt[]
  xpTransactions       XPTransaction[]
  lessonViews          LessonView[]
  scenarioAnswers      ScenarioAnswer[]
  questionAnswers      DailyQuestionAnswer[]
  badges               UserBadge[]
  lessonFeedback       LessonFeedback[]
  revisionItems        RevisionItem[]
  revisionAnswers      RevisionAnswer[]
  scenarioRuns         ScenarioRun[]
  rewardUnlocks        RewardUnlock[]
  activityDays         ActivityDay[]
  dailyChallengeRuns   DailyChallengeRun[]
  coachFollowUps       CoachFollowUp[]
  moneyEntries         MoneyEntry[]
  moneyBudgets         MoneyBudget[]
  moneyCheckIns        MoneyCheckIn[]
  savingsGoals         SavingsGoal[]
  savingsDeposits      SavingsDeposit[]
  challengeEnrollments ChallengeEnrollment[]
  challengeCheckIns    ChallengeCheckIn[]
  avatarEvents         AvatarEvent[]
  virtualPortfolio     VirtualPortfolio?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id                  String        @id @default(cuid())
  slug                String        @unique
  title               String
  icon                String        @default("📘")
  area                ReadinessArea
  description         String
  // Part 1, a relatable situation that gets the student thinking.
  hook                String        @default("") @db.Text
  // Part 2, short explanation; each "## " section renders as its own card.
  contentMarkdown     String        @db.Text
  // [{ term, definition }], shown while learning and on the completion screen.
  keyTerms            Json          @default("[]")
  // A real-life Indian example with numbers.
  example             String        @default("") @db.Text
  // "What would you do?" before the quiz. Options: [{ text, isCorrect }].
  scenarioPrompt      String        @default("") @db.Text
  scenarioOptions     Json          @default("[]")
  scenarioExplanation String        @default("") @db.Text
  estimatedMinutes    Int           @default(5)
  xpReward            Int           @default(75)
  isPublished         Boolean       @default(false)
  order               Int           @default(0)
  // Content trust: [{ label, url }] for the important claims, when the lesson
  // was last reviewed, and (for tax) the year its rules apply to.
  sources             Json          @default("[]")
  reviewedAt          DateTime?
  appliesTo           String?

  questions       Question[]
  attempts        QuizAttempt[]
  views           LessonView[]
  scenarioAnswers ScenarioAnswer[]
  feedback        LessonFeedback[]
  revisionItems   RevisionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per (user, lesson) the first time the student opens that lesson, 
// feeds the "signup → first lesson" metric.
model LessonView {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

// The student's first answer to a lesson's scenario. Later re-answers don't
// overwrite it, so it shows how students decide before being taught twice.
model ScenarioAnswer {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  optionIndex Int
  isCorrect   Boolean
  answeredAt  DateTime @default(now())

  @@unique([userId, lessonId])
}

model Question {
  id                  String          @id @default(cuid())
  lessonId            String
  lesson              Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  prompt              String
  explanation         String          @db.Text
  // Written by the course team; shown when the AI Coach is unavailable.
  hint                String?         @db.Text
  difficulty          Difficulty      @default(MEDIUM)
  order               Int             @default(0)
  // A second question on the same idea with a different example: the AI
  // Coach's check after a mistake, and what revision asks later.
  practicePrompt      String?         @db.Text
  // [{ text, isCorrect }]
  practiceOptions     Json?
  practiceExplanation String?         @db.Text
  options             Option[]
  answers             QuizAnswer[]
  coachHints          CoachHint[]
  revisionItems       RevisionItem[]
  coachFollowUps      CoachFollowUp[]
  createdAt           DateTime        @default(now())
}

model Option {
  id         String       @id @default(cuid())
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
  answers    QuizAnswer[]
}

model QuizAttempt {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  lessonId        String
  lesson          Lesson          @relation(fields: [lessonId], references: [id])
  status          AttemptStatus   @default(IN_PROGRESS)
  // Questions answered correctly on the first try.
  score           Int             @default(0)
  // 0-100, set on completion: first-try answers count fully, ones solved
  // after Coach hints count half. Feeds the Financial Readiness Score.
  mastery         Int?
  totalQuestions  Int             @default(5)
  xpAwarded       Int?
  // Overall readiness just before and after this attempt completed, so the
  // completion screen can show the change.
  readinessBefore Int?
  readinessAfter  Int?
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  answers         QuizAnswer[]
  xpTransactions  XPTransaction[]
  badges          UserBadge[]
  coachFollowUps  CoachFollowUp[]

  @@index([userId, lessonId])
}

model QuizAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  // Cascades so the seed can replace a lesson's questions (delete + recreate)
  // without hitting FK violations from historical answers, those answers
  // become meaningless once the question they referenced is gone anyway.
  // XP already earned is untouched: it lives in XPTransaction, not here.
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String
  selectedOption   Option      @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  isCorrect        Boolean
  // 1 for the first pick on a question; wrong picks earn a Coach hint and
  // another try, up to MAX_TRIES_PER_QUESTION.
  tryNumber        Int         @default(1)
  answeredAt       DateTime    @default(now())

  @@unique([attemptId, questionId, tryNumber])
}

// AI Coach hints, generated once per (question, set of wrong options picked
// so far) and reused for every student who takes the same wrong path, keeps
// hints consistent, reviewable, and the total number of model calls bounded.
model CoachHint {
  id             String   @id @default(cuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Sorted, comma-joined ids of the wrong options picked so far.
  wrongOptionIds String
  level          Int
  text           String   @db.Text
  model          String
  createdAt      DateTime @default(now())

  @@unique([questionId, wrongOptionIds])
}

// The Question of the Day pool: one short real-life money decision a day,
// picked per student from the questions they haven't answered yet.
model DailyQuestion {
  id          String                @id @default(cuid())
  prompt      String                @db.Text
  // [{ text, isCorrect }]
  options     Json
  explanation String                @db.Text
  area        ReadinessArea
  isPublished Boolean               @default(true)
  order       Int                   @default(0)
  answers     DailyQuestionAnswer[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model DailyQuestionAnswer {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    DailyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // IST date (YYYY-MM-DD), one answer per student per day.
  day         String
  optionIndex Int
  isCorrect   Boolean
  xpAwarded   Int           @default(0)
  answeredAt  DateTime      @default(now())

  @@unique([userId, day])
}

// A finished Daily Challenge (content in src/lib/daily-challenge): a short
// multi-step set, one per student per IST day.
model DailyChallengeRun {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          String
  // Which challenge it was, e.g. "quickfire-CREDIT" or "spot-the-scams".
  challengeKey String
  score        Int
  maxScore     Int
  answers      Json
  xpAwarded    Int      @default(0)
  completedAt  DateTime @default(now())

  @@unique([userId, day])
}

// One row per IST day a student did a meaningful learning action, the
// streak calendar. `frozen` marks a missed day a streak freeze covered.
model ActivityDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String
  frozen    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, day])
}

// A follow-up question a student asked the AI Coach about a quiz question
// they'd already answered, and the Coach's reply.
model CoachFollowUp {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  message    String      @db.Text
  reply      String      @db.Text
  model      String
  createdAt  DateTime    @default(now())

  @@index([attemptId, questionId])
}

model XPTransaction {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  amount         Int
  type           XPTransactionType
  quizAttemptId  String?
  quizAttempt    QuizAttempt?      @relation(fields: [quizAttemptId], references: [id])
  description    String?
  // One key per reward (e.g. "lesson-complete:<user>:<lesson>"), so a retried
  // or duplicated request can never pay the same reward twice.
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())

  @@index([userId, createdAt])
}

// A badge a student has earned. The definitions (name, rule) live in
// src/lib/badges.ts; a row here is permanent, even if lessons are added later.
model UserBadge {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId       String
  // The quiz attempt that unlocked it, so the completion screen can celebrate it.
  quizAttemptId String?
  quizAttempt   QuizAttempt? @relation(fields: [quizAttemptId], references: [id], onDelete: SetNull)
  earnedAt      DateTime     @default(now())

  @@unique([userId, badgeId])
}

// "Was this lesson clear and useful?" from the completion screen, one per
// student per lesson, editable.
model LessonFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  helpful   Boolean
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

// One concept a student should revisit, scheduled at 1, 3 and 7 days.
model RevisionItem {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kind        RevisionKind
  // 0 → due 1 day later, 1 → 3 days, 2 → 7 days; passing stage 2 retires it.
  stage       Int              @default(0)
  // IST date (YYYY-MM-DD) from which it's due.
  dueDay      String
  status      RevisionStatus   @default(ACTIVE)
  lastCorrect Boolean?
  answers     RevisionAnswer[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, questionId])
  @@index([userId, status, dueDay])
}

model RevisionAnswer {
  id            String          @id @default(cuid())
  itemId        String
  item          RevisionItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  context       RevisionContext
  stage         Int
  optionIndex   Int
  isCorrect     Boolean
  // Set for COACH_CHECK answers: one check per question per quiz attempt.
  quizAttemptId String?
  answeredAt    DateTime        @default(now())

  @@unique([quizAttemptId, itemId])
  @@index([userId, answeredAt])
}

// A completed run through an interactive money scenario (content lives in
// src/lib/scenarios). Students can replay; XP comes only from the first.
model ScenarioRun {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioSlug String
  score        Int
  maxScore     Int
  answers      Json
  completedAt  DateTime @default(now())

  @@index([userId, scenarioSlug])
}

// A Rewards Store item a student unlocked with XP (catalogue in src/lib/rewards.ts).
model RewardUnlock {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId   String
  costXp     Int
  unlockedAt DateTime @default(now())

  @@unique([userId, rewardId])
}

// ── Money Manager ─────────────────────────────────────────────────────────
// A student's own money: what comes in, what goes out. Amounts are whole
// rupees; `day` is the IST date the money moved.

model MoneyEntry {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      MoneyEntryKind
  amount    Int
  // A category id from src/lib/money/categories.ts (food, shopping, travel, …).
  category  String
  note      String?
  day       String
  createdAt DateTime       @default(now())

  @@index([userId, day])
}

// A monthly spending budget: one row per category per month ("total" for the overall cap).
model MoneyBudget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // YYYY-MM, IST.
  month     String
  category  String
  amount    Int
  updatedAt DateTime @updatedAt

  @@unique([userId, month, category])
}

// One row per IST day the student checked in on their money.
model MoneyCheckIn {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String
  kind      MoneyCheckInKind
  createdAt DateTime         @default(now())

  @@unique([userId, day])
}

model SavingsGoal {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  // An icon key from src/lib/money/goals.ts.
  icon        String
  target      Int
  saved       Int              @default(0)
  // Optional IST date to reach it by.
  targetDay   String?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  deposits    SavingsDeposit[]

  @@index([userId])
}

// Money put into (or taken out of, when negative) a savings goal.
model SavingsDeposit {
  id        String      @id @default(cuid())
  goalId    String
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  day       String
  createdAt DateTime    @default(now())

  @@index([userId, day])
}

// ── Practice challenges ──────────────────────────────────────────────────
// The 30-day money habit challenge and the shorter saving challenges
// (definitions in src/lib/challenges). One step per calendar day; missed
// days are never punished, you simply continue where you left off.

model ChallengeEnrollment {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  checkIns    ChallengeCheckIn[]

  @@unique([userId, challengeId])
}

model ChallengeCheckIn {
  id           String              @id @default(cuid())
  enrollmentId String
  enrollment   ChallengeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which step (1 = the first).
  stepNumber   Int
  // The IST day it was done, one step per day per challenge.
  day          String
  // The student's pick for a step that asks a question, if any.
  choice       Int?
  createdAt    DateTime            @default(now())

  @@unique([enrollmentId, stepNumber])
  @@unique([enrollmentId, day])
  @@index([userId, day])
}

// ── The talking avatar ───────────────────────────────────────────────────
// One row per real event the student's avatar reacts to (a lesson finished,
// a budget crossed, a goal reached…). The key is unique per student, so the
// same event can never produce a second reaction; shownAt records when the
// pop-up was shown (or skipped because reactions are off).
model AvatarEvent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // e.g. "lesson:<attemptId>", "budget-over:2026-11:food", "goal:<goalId>".
  key       String
  // The reaction to show (see src/lib/avatar/reactions.ts).
  kind      String
  // 0 ordinary · 1 important · 2 major milestone.
  priority  Int       @default(0)
  data      Json      @default("{}")
  createdAt DateTime  @default(now())
  shownAt   DateTime?

  @@unique([userId, key])
  @@index([userId, shownAt])
}

// ── InvestSmart virtual portfolio ───────────────────────────────────────
// Practice money only: every student starts with virtual ₹1,00,000, invests
// it in a few simple options and fast-forwards simulated months. Returns are
// simulated on the server from a fixed seed (src/lib/invest), illustrative,
// not real market data, and never advice.
model VirtualPortfolio {
  id         String             @id @default(cuid())
  userId     String             @unique
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Uninvested virtual rupees.
  cash       Float              @default(100000)
  // Simulated months elapsed since the start (or the last reset).
  month      Int                @default(0)
  // Each reset starts a new "run" (so a fresh start gets fresh reactions).
  run        Int                @default(1)
  // The total value's change in the most recent simulated month, as a fraction.
  lastChange Float              @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  holdings   VirtualHolding[]
  history    VirtualSnapshot[]
}

model VirtualHolding {
  id          String           @id @default(cuid())
  portfolioId String
  portfolio   VirtualPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  // An asset id from src/lib/invest/assets.ts.
  asset       String
  // Virtual rupees put in (net of withdrawals), and what they're worth now.
  invested    Float
  value       Float

  @@unique([portfolioId, asset])
}

// The portfolio's total at the end of each simulated month, for the chart.
model VirtualSnapshot {
  id          String           @id @default(cuid())
  portfolioId String
  portfolio   VirtualPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  month       Int
  total       Float

  @@unique([portfolioId, month])
}
