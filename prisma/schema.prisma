generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// The six Financial Readiness areas on the dashboard. Each lesson feeds
// exactly one of them.
enum ReadinessArea {
  BUDGETING
  DIGITAL_SAFETY
  BANKING
  CREDIT
  TAX
  INVESTING
}

// Asked during onboarding.
enum LearnerStage {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FINAL_YEAR
  GRADUATE_WORKING
}

// Asked (optionally) during onboarding; editable on the profile page.
enum LearningGoal {
  MANAGING_MONEY
  CREDIT
  INVESTING
  AVOIDING_SCAMS
  SALARY_TAXES
  EVERYTHING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum XPTransactionType {
  SIGNUP_BONUS
  QUIZ_COMPLETION
  DAILY_CHALLENGE
  LEVEL_COMPLETION
  STREAK_BONUS
  ADMIN_ADJUSTMENT
  // XP spent in the Rewards Store — a negative amount.
  REDEMPTION
  SCENARIO_COMPLETION
  REVISION
}

// MISTAKE: a question the student missed, brought back at 1, 3 and 7 days.
// CHECK: a 7-day retention check on a lesson they got right.
enum RevisionKind {
  MISTAKE
  CHECK
}

enum RevisionStatus {
  ACTIVE
  DONE
}

// COACH_CHECK: the AI Coach's "check you've got it" question during a quiz.
// REVIEW: a scheduled revision question.
enum RevisionContext {
  COACH_CHECK
  REVIEW
}

model User {
  id            String  @id @default(cuid())
  clerkId       String  @unique
  email         String  @unique
  emailVerified Boolean @default(false)
  phone         String? @unique
  phoneVerified Boolean @default(false)
  name          String?
  displayName   String?

  stage                 LearnerStage?
  goal                  LearningGoal?
  collegeName           String?
  onboardingCompletedAt DateTime?

  // Lifetime XP earned — never goes down. Spendable XP is xpTotal - xpSpent.
  xpTotal Int     @default(0)
  xpSpent Int     @default(0)
  // Equipped Rewards Store unlocks (reward ids from src/lib/rewards.ts).
  title   String?
  theme   String?

  // Optional daily reminder email at this IST hour (0-23).
  reminderEnabled     Boolean @default(false)
  reminderHour        Int     @default(20)
  reminderLastSentDay String?

  // Days in a row with a meaningful learning action (quiz, scenario, daily
  // challenge or revision), counted in IST calendar days.
  currentStreak          Int       @default(0)
  longestStreak          Int       @default(0)
  // IST date (YYYY-MM-DD) of the last day that counted toward the streak.
  streakLastDay          String?
  // Last time the student opened a lesson or started a quiz — feeds retention metrics.
  lastActivityDate       DateTime?
  streakFreezesAvailable Int       @default(3)
  streakFreezesResetAt   DateTime?

  quizAttempts     QuizAttempt[]
  xpTransactions   XPTransaction[]
  lessonViews      LessonView[]
  scenarioAnswers  ScenarioAnswer[]
  challengeAnswers ChallengeAnswer[]
  badges           UserBadge[]
  lessonFeedback   LessonFeedback[]
  revisionItems    RevisionItem[]
  revisionAnswers  RevisionAnswer[]
  scenarioRuns     ScenarioRun[]
  rewardUnlocks    RewardUnlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id                  String        @id @default(cuid())
  slug                String        @unique
  title               String
  icon                String        @default("📘")
  area                ReadinessArea
  description         String
  // Part 1 — a relatable situation that gets the student thinking.
  hook                String        @default("") @db.Text
  // Part 2 — short explanation; each "## " section renders as its own card.
  contentMarkdown     String        @db.Text
  // [{ term, definition }] — shown while learning and on the completion screen.
  keyTerms            Json          @default("[]")
  // A real-life Indian example with numbers.
  example             String        @default("") @db.Text
  // "What would you do?" before the quiz. Options: [{ text, isCorrect }].
  scenarioPrompt      String        @default("") @db.Text
  scenarioOptions     Json          @default("[]")
  scenarioExplanation String        @default("") @db.Text
  estimatedMinutes    Int           @default(5)
  xpReward            Int           @default(75)
  isPublished         Boolean       @default(false)
  order               Int           @default(0)
  // Content trust: [{ label, url }] for the important claims, when the lesson
  // was last reviewed, and (for tax) the year its rules apply to.
  sources             Json          @default("[]")
  reviewedAt          DateTime?
  appliesTo           String?

  questions       Question[]
  attempts        QuizAttempt[]
  views           LessonView[]
  scenarioAnswers ScenarioAnswer[]
  feedback        LessonFeedback[]
  revisionItems   RevisionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per (user, lesson) the first time the student opens that lesson —
// feeds the "signup → first lesson" metric.
model LessonView {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

// The student's first answer to a lesson's scenario. Later re-answers don't
// overwrite it, so it shows how students decide before being taught twice.
model ScenarioAnswer {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  optionIndex Int
  isCorrect   Boolean
  answeredAt  DateTime @default(now())

  @@unique([userId, lessonId])
}

model Question {
  id                  String         @id @default(cuid())
  lessonId            String
  lesson              Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  prompt              String
  explanation         String         @db.Text
  // Written by the course team; shown when the AI Coach is unavailable.
  hint                String?        @db.Text
  difficulty          Difficulty     @default(MEDIUM)
  order               Int            @default(0)
  // A second question on the same idea with a different example: the AI
  // Coach's check after a mistake, and what revision asks later.
  practicePrompt      String?        @db.Text
  // [{ text, isCorrect }]
  practiceOptions     Json?
  practiceExplanation String?        @db.Text
  options             Option[]
  answers             QuizAnswer[]
  coachHints          CoachHint[]
  revisionItems       RevisionItem[]
  createdAt           DateTime       @default(now())
}

model Option {
  id         String       @id @default(cuid())
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
  answers    QuizAnswer[]
}

model QuizAttempt {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  lessonId        String
  lesson          Lesson          @relation(fields: [lessonId], references: [id])
  status          AttemptStatus   @default(IN_PROGRESS)
  // Questions answered correctly on the first try.
  score           Int             @default(0)
  // 0-100, set on completion: first-try answers count fully, ones solved
  // after Coach hints count half. Feeds the Financial Readiness Score.
  mastery         Int?
  totalQuestions  Int             @default(5)
  xpAwarded       Int?
  // Overall readiness just before and after this attempt completed, so the
  // completion screen can show the change.
  readinessBefore Int?
  readinessAfter  Int?
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  answers         QuizAnswer[]
  xpTransactions  XPTransaction[]
  badges          UserBadge[]

  @@index([userId, lessonId])
}

model QuizAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  // Cascades so the seed can replace a lesson's questions (delete + recreate)
  // without hitting FK violations from historical answers — those answers
  // become meaningless once the question they referenced is gone anyway.
  // XP already earned is untouched: it lives in XPTransaction, not here.
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String
  selectedOption   Option      @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)
  isCorrect        Boolean
  // 1 for the first pick on a question; wrong picks earn a Coach hint and
  // another try, up to MAX_TRIES_PER_QUESTION.
  tryNumber        Int         @default(1)
  answeredAt       DateTime    @default(now())

  @@unique([attemptId, questionId, tryNumber])
}

// AI Coach hints, generated once per (question, set of wrong options picked
// so far) and reused for every student who takes the same wrong path — keeps
// hints consistent, reviewable, and the total number of model calls bounded.
model CoachHint {
  id             String   @id @default(cuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Sorted, comma-joined ids of the wrong options picked so far.
  wrongOptionIds String
  level          Int
  text           String   @db.Text
  model          String
  createdAt      DateTime @default(now())

  @@unique([questionId, wrongOptionIds])
}

// A pool of short real-life scenarios. Each day every student gets the same
// one, picked by rotating through the published pool in `order`.
model DailyChallenge {
  id          String            @id @default(cuid())
  prompt      String            @db.Text
  // [{ text, isCorrect }]
  options     Json
  explanation String            @db.Text
  area        ReadinessArea
  isPublished Boolean           @default(true)
  order       Int               @default(0)
  answers     ChallengeAnswer[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ChallengeAnswer {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  // IST date (YYYY-MM-DD) — one answer per student per day.
  day         String
  optionIndex Int
  isCorrect   Boolean
  xpAwarded   Int            @default(0)
  answeredAt  DateTime       @default(now())

  @@unique([userId, day])
}

model XPTransaction {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  amount         Int
  type           XPTransactionType
  quizAttemptId  String?
  quizAttempt    QuizAttempt?      @relation(fields: [quizAttemptId], references: [id])
  description    String?
  // One key per reward (e.g. "lesson-complete:<user>:<lesson>"), so a retried
  // or duplicated request can never pay the same reward twice.
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())

  @@index([userId, createdAt])
}

// A badge a student has earned. The definitions (name, rule) live in
// src/lib/badges.ts; a row here is permanent, even if lessons are added later.
model UserBadge {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId       String
  // The quiz attempt that unlocked it, so the completion screen can celebrate it.
  quizAttemptId String?
  quizAttempt   QuizAttempt? @relation(fields: [quizAttemptId], references: [id], onDelete: SetNull)
  earnedAt      DateTime     @default(now())

  @@unique([userId, badgeId])
}

// "Was this lesson clear and useful?" from the completion screen — one per
// student per lesson, editable.
model LessonFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  helpful   Boolean
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

// One concept a student should revisit, scheduled at 1, 3 and 7 days.
model RevisionItem {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kind        RevisionKind
  // 0 → due 1 day later, 1 → 3 days, 2 → 7 days; passing stage 2 retires it.
  stage       Int              @default(0)
  // IST date (YYYY-MM-DD) from which it's due.
  dueDay      String
  status      RevisionStatus   @default(ACTIVE)
  lastCorrect Boolean?
  answers     RevisionAnswer[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, questionId])
  @@index([userId, status, dueDay])
}

model RevisionAnswer {
  id            String          @id @default(cuid())
  itemId        String
  item          RevisionItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  context       RevisionContext
  stage         Int
  optionIndex   Int
  isCorrect     Boolean
  // Set for COACH_CHECK answers: one check per question per quiz attempt.
  quizAttemptId String?
  answeredAt    DateTime        @default(now())

  @@unique([quizAttemptId, itemId])
  @@index([userId, answeredAt])
}

// A completed run through an interactive money scenario (content lives in
// src/lib/scenarios). Students can replay; XP comes only from the first.
model ScenarioRun {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioSlug String
  score        Int
  maxScore     Int
  answers      Json
  completedAt  DateTime @default(now())

  @@index([userId, scenarioSlug])
}

// A Rewards Store item a student unlocked with XP (catalogue in src/lib/rewards.ts).
model RewardUnlock {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId   String
  costXp     Int
  unlockedAt DateTime @default(now())

  @@unique([userId, rewardId])
}
